# Copy to .env (never commit .env). Placeholders only; the values below match docker-compose.yml for local dev.
NODE_ENV=development
PORT=4000

# Local Docker database credentials (see docker-compose.yml). Change both places together.
DATABASE_URL=postgres://subcycle:subcycle_local_pw@localhost:5433/subcycle_dev
TEST_DATABASE_URL=postgres://subcycle:subcycle_local_pw@localhost:5433/subcycle_test

# Comma-separated explicit CORS allow-list.
CORS_ORIGINS=http://localhost:5173

# Number of reverse proxies in front of the API, or false (default). Needed so the per-IP login limiter sees the real client
# address behind a platform proxy (Render: 1). Only a hop count is accepted, never "true" (that would trust spoofable headers).
TRUST_PROXY=false

# true => use the controllable fake clock (dev/test only; enables POST /dev/advance-clock in a later stage).
FAKE_CLOCK=false

# Safety valve: set true only if you really want db:reset against a non-local host.
ALLOW_DB_RESET=false

# --- Authentication (Stage 2) ---
# REQUIRED in production, at least 32 random characters (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`).
# If unset in development/test, a fixed non-secret development value is used (rejected in production).
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=3600
# bcrypt cost; defaults to 12 (4 under NODE_ENV=test). Minimum 10 in production.
# BCRYPT_COST=12
# Per-IP limit on /auth/* requests.
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=900000

# --- Usage ---
# Per-user request limiter for /usage and /demo (separate from per-plan LIMIT_EXCEEDED).
USAGE_RATE_LIMIT_MAX=600
USAGE_RATE_LIMIT_WINDOW_MS=60000

# --- Jobs (renewals + reconciliation, docs/DECISIONS.md B19) ---
RUN_JOBS=true
# node-cron expression; the job is idempotent and safe across multiple processes.
JOBS_CRON=* * * * *
JOBS_BATCH_SIZE=100
# Mounts POST /dev/run-renewals and /dev/advance-clock (authenticated). Forced off when NODE_ENV=production.
ENABLE_DEV_ENDPOINTS=true

# --- Billing (mock provider; v1 has no real gateway) ---
# never (default) | always | random:<probability 0..1>. random is a deterministic function of the idempotency key.
MOCK_BILLING_FAIL=never
# A provider call slower than this is an UNKNOWN outcome: reconciled later, never retried with a new key.
BILLING_TIMEOUT_MS=10000
# Pending billing operations older than this are picked up by the reconciliation job (wired to cron in Stage 6).
RECONCILE_AFTER_MINUTES=5

# --- Frontend (client/) ---
# Dev/preview proxy target for /api (default http://localhost:4000). Set VITE_API_URL at build time to call an API directly.
# VITE_PROXY_TARGET=http://localhost:4000
# VITE_API_URL=
