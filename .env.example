# Copy to .env (never commit .env). Placeholders only; the values below match docker-compose.yml for local dev.
NODE_ENV=development
PORT=4000

# Local Docker database credentials (see docker-compose.yml). Change both places together.
DATABASE_URL=postgres://subcycle:subcycle_local_pw@localhost:5433/subcycle_dev
TEST_DATABASE_URL=postgres://subcycle:subcycle_local_pw@localhost:5433/subcycle_test

# Comma-separated explicit CORS allow-list.
CORS_ORIGINS=http://localhost:5173

# true => use the controllable fake clock (dev/test only; enables POST /dev/advance-clock in a later stage).
FAKE_CLOCK=false

# Safety valve: set true only if you really want db:reset against a non-local host.
ALLOW_DB_RESET=false

# --- Authentication (Stage 2) ---
# REQUIRED in production, at least 32 random characters (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`).
# If unset in development/test, a fixed non-secret development value is used (rejected in production).
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=3600
# bcrypt cost; defaults to 12 (4 under NODE_ENV=test). Minimum 10 in production.
# BCRYPT_COST=12
# Per-IP limit on /auth/* requests.
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Used from Stage 3 onward (placeholder):
# MOCK_BILLING_FAIL=never
